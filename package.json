    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint-config-prettier": "^10.1.8",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "typescript-eslint": "^8.64.0",
    "typescript": "6"
  }
}
